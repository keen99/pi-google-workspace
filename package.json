{
  "name": "pi-google-workspace",
  "version": "1.5.0-keen99",
  "description": "Google Workspace extension for pi (Drive, Docs, Sheets, Slides with OAuth)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geun-Oh/pi-google-workspace.git"
  },
  "homepage": "https://github.com/Geun-Oh/pi-google-workspace#readme",
  "bugs": {
    "url": "https://github.com/Geun-Oh/pi-google-workspace/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent",
    "extension",
    "google-workspace",
    "google-drive",
    "google-docs",
    "google-sheets",
    "google-slides"
  ],
  "files": [
    "index.ts",
    "README.md",
    "google-workspace.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "bash check.sh"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
