#!/usr/bin/env bash
# Pre-commit: type-check + tests. Blocks on any failure.
set -euo pipefail
DIR="$(git rev-parse --show-toplevel)"
cd "$DIR"

# Ensure dev deps present in worktree.
if [ ! -x "$DIR/node_modules/.bin/tsc" ] || [ ! -x "$DIR/node_modules/.bin/vitest" ]; then
  echo ">> install missing dev dependencies"
  NPM_WRAPPER_ALLOW_LOCAL=1 npm install
fi

echo ">> type-check (tsc --noEmit)"
if ! "$DIR/node_modules/.bin/tsc" --noEmit 2>&1; then
  echo "FAIL: TS errors (commit blocked)"
  exit 1
fi

# Skip tests if no test dir (older checkouts).
if [ -d "$DIR/test" ]; then
  echo ">> tests (vitest run)"
  if ! "$DIR/node_modules/.bin/vitest" run 2>&1; then
    echo "FAIL: tests failed (commit blocked)"
    exit 1
  fi
fi

echo "OK: type-check + tests pass"
exit 0
